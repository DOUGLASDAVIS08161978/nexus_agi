# Nexus AGI MCP Server Configuration
# Copy this file to .env and update with your values

# MCP Server Configuration
MCP_PORT=3001
MCP_HOST=0.0.0.0

# Authentication
# Comma-separated list of API keys for authentication
MCP_API_KEYS=nexus-agi-default-key,your-custom-key-here

# CORS Configuration
# Comma-separated list of allowed origins (* for all)
MCP_CORS_ORIGINS=*

# Remote Server URL (for connecting to this server remotely)
# If deploying to cloud, set this to your public URL
MCP_REMOTE_URL=http://localhost:3001/mcp

# MCP Client API Key (for connecting to this server)
MCP_API_KEY=nexus-agi-default-key

# Optional: External Service Configuration
# HUGGINGFACE_TOKEN=your_hf_token_here
# GOOGLE_CLOUD_PROJECT=your_gcp_project
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AZURE_SUBSCRIPTION_ID=your_azure_subscription

# Optional: Database Configuration
# DATABASE_URL=postgresql://user:pass@localhost:5432/nexus_agi

# Optional: Monitoring and Logging
# LOG_LEVEL=info
# METRICS_ENABLED=true
# SENTRY_DSN=your_sentry_dsn
