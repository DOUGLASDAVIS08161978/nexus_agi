# Nexus AGI Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Nexus AGI
APP_VERSION=4.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# ============================================================================
# API GATEWAY SETTINGS
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

# Stripe (Recommended)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# PayPal (Alternative/Additional)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox  # sandbox or live

# Cryptocurrency Payments
# Option 1: Coinbase Commerce (Easiest)
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# Option 2: BTCPay Server (Self-hosted, more control)
BTCPAY_SERVER_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# Your Bitcoin Wallet (Profits deposited here)
BITCOIN_WALLET_ADDRESS=bc1q2m6w8au8yrjp85m7rqlcxqx9ypfla6h8st8u78

# App URL (for payment redirects)
APP_URL=http://localhost:8000

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_agi
# Or use SQLite for development:
# DATABASE_URL=sqlite:///./nexus_agi.db

REDIS_URL=redis://localhost:6379/0
# For usage tracking and rate limiting

# ============================================================================
# EXTERNAL API KEYS
# ============================================================================

# Web Search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_KEY=
BING_SEARCH_API_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_ORG=

# OpenAI (if needed for embeddings)
OPENAI_API_KEY=

# Anthropic Claude (if integrating)
ANTHROPIC_API_KEY=

# Other Services
HUGGINGFACE_TOKEN=
ARXIV_API_KEY=

# ============================================================================
# TOOL CONFIGURATION
# ============================================================================

# HTTP Fetch Tool
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_RATE_LIMIT=100  # requests per minute

# Web Search Tool
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=15

# GitHub Tool
GITHUB_MAX_REPO_SIZE=100  # MB
GITHUB_RATE_LIMIT=50  # requests per hour

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================

# Rate limits (requests per minute)
RATE_LIMIT_FREE=10
RATE_LIMIT_STARTER=100
RATE_LIMIT_PROFESSIONAL=1000
RATE_LIMIT_ENTERPRISE=10000

# Request timeouts (seconds)
REQUEST_TIMEOUT_DEFAULT=60
REQUEST_TIMEOUT_MAX=300

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/nexus_agi.log

# Sentry (error tracking)
SENTRY_DSN=

# Analytics
ANALYTICS_ENABLED=true
MIXPANEL_TOKEN=
GOOGLE_ANALYTICS_ID=

# ============================================================================
# EMAIL (for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@nexusagi.com

# SendGrid (alternative)
SENDGRID_API_KEY=

# ============================================================================
# DEPLOYMENT
# ============================================================================

# Docker
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_PAYMENT_PROCESSING=true
ENABLE_USAGE_TRACKING=true
ENABLE_RATE_LIMITING=true
ENABLE_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================================================
# PRICING (USD)
# ============================================================================
PRICE_STARTER=29
PRICE_PROFESSIONAL=99
PRICE_ENTERPRISE=499

# Free tier limits
FREE_TIER_REQUESTS=100
FREE_TIER_DURATION_DAYS=30
