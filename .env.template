# NEXUS AGI - BITCOIN PAYMENT CONFIGURATION
# This is a template - will be configured with your actual wallet

# CRITICAL: Your Bitcoin Wallet Address
BITCOIN_WALLET_ADDRESS=REPLACE_WITH_YOUR_FULL_WALLET_ADDRESS

# Payment Processor (we'll use Coinbase Commerce for easiest setup)
PAYMENT_PROCESSOR=coinbase
COINBASE_COMMERCE_API_KEY=REPLACE_WITH_COINBASE_KEY

# Alternative: BTCPay Server (if you prefer)
# PAYMENT_PROCESSOR=btcpay
# BTCPAY_SERVER_URL=https://your-btcpay.com
# BTCPAY_API_KEY=your_key
# BTCPAY_STORE_ID=your_store_id

# Pricing Configuration
PRICE_PER_API_CALL_USD=0.05
PRICE_CONSULTATION_USD=100
PRICE_ANALYSIS_USD=100
PRICE_CODE_GENERATION_USD=50

# Auto-Withdrawal Settings
AUTO_WITHDRAW_TO_WALLET=true
MIN_BALANCE_BEFORE_WITHDRAW=0.01
WITHDRAW_SCHEDULE=daily

# Security
ADMIN_KEY=nexus_admin_$(openssl rand -hex 16)
API_RATE_LIMIT=100
REQUIRE_PAYMENT_CONFIRMATION=3

# API Configuration
API_URL=http://localhost:8000
ENVIRONMENT=production
LOG_LEVEL=INFO
