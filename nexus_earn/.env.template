# ════════════════════════════════════════════════════════
# Nexus Earn — Environment Variables
# Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────
# Your Anthropic API key (get it at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Your Stripe SECRET key (get it at dashboard.stripe.com)
# Use sk_test_... for testing, sk_live_... when going live
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (from Stripe dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Your deployed URL (update after deploying to Railway)
BASE_URL=https://your-app.railway.app

# ── OPTIONAL ──────────────────────────────────────────────
# Claude model to use (haiku is cheapest, sonnet is smarter)
# claude-haiku-4-5-20251001  ← fast & cheap (recommended to start)
# claude-sonnet-4-6          ← smarter, costs more
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── STRIPE PRICE IDs ──────────────────────────────────────
# After creating products in Stripe dashboard, paste the
# price IDs here (format: price_xxxxxxxxxxxxxxxxxxxx)
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_UNLIMITED=price_
