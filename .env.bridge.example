# Bitcoin to Ethereum Bridge Configuration
# Copy this file to .env.bridge and fill in your values

# =============================================================================
# ETHEREUM CONFIGURATION
# =============================================================================

# Ethereum private key for signing transactions
# IMPORTANT: Never commit this file with real keys!
ETH_PRIVATE_KEY=your_ethereum_private_key_here_without_0x_prefix

# Ethereum network: mainnet, goerli, sepolia, arbitrum, arbitrum-sepolia, optimism,
# optimism-sepolia, base, base-sepolia, polygon, avalanche, avalanche-fuji, bsc, bsc-testnet
ETH_NETWORK=mainnet

# Ethereum destination address for bridge transfers
ETH_DESTINATION_ADDRESS=0x12f4441ec006a6b00ae8bc8800c2443f9b0c775d

# Target blockchain for final bridge destination
# Options: ethereum, arbitrum, optimism, base, polygon, avalanche, bsc
TARGET_NETWORK=ethereum

# =============================================================================
# BITCOIN CONFIGURATION
# =============================================================================

# Bitcoin network: mainnet, testnet
BTC_NETWORK=mainnet

# Bitcoin source address (wallet to bridge from)
BTC_SOURCE_ADDRESS=bc1qfzhx87ckhn4tnkswhsth56h0gm5we4hdq5wass

# Bitcoin transaction hash (if already sent)
# Leave empty if creating new transaction
BTC_TX_HASH=

# =============================================================================
# SMTP EMAIL NOTIFICATIONS (Optional)
# =============================================================================

# SMTP server configuration for email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email credentials
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email recipient for notifications
NOTIFICATION_EMAIL=your_email@gmail.com

# =============================================================================
# BRIDGE SETTINGS
# =============================================================================

# Minimum confirmations required
MIN_BTC_CONFIRMATIONS=6
MIN_ETH_CONFIRMATIONS=12

# Bridge fee (percentage)
BRIDGE_FEE_PERCENT=0.1

# Transaction timeout (seconds)
CONFIRMATION_TIMEOUT=600

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=bridge_transfers.log
